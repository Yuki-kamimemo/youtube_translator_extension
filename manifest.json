{
    "manifest_version": 3,
    "name": "YouTube Live Chat Enhancer",
    "version": "3.1.1",
    "description": "YouTubeライブチャットを翻訳し、画面上にコメントを流す機能を提供します。",
    "permissions": [
        "storage",
        "alarms"
    ],
    "action": {
        "default_title": "チャット設定を開く",
        "default_popup": "popup.html",
        "default_icon": {
            "16": "images/icon16.png",
            "48": "images/icon48.png",
            "128": "images/icon128.png"
        }
    },
    "background": {
        "service_worker": "background.js",
        "scripts": [
            "translation.js",
            "background.js"
        ]
    },
    "content_scripts": [
        {
            "matches": [
                "*://www.youtube.com/*",
                "*://m.youtube.com/*"
            ],
            "exclude_matches": [
                "*://www.youtube.com/live_chat*",
                "*://m.youtube.com/live_chat*"
            ],
            "js": [
                "extension_api.js",
                "translation.js",
                "flow.js",
                "content_script.js"
            ],
            "css": [
                "content_script.css"
            ],
            "all_frames": false
        },
        {
            "matches": [
                "*://www.youtube.com/live_chat*",
                "*://m.youtube.com/live_chat*"
            ],
            "js": [
                "extension_api.js",
                "translation.js",
                "chat_observer.js"
            ],
            "all_frames": true
        }
    ],
    "host_permissions": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*",
        "https://*.googleapis.com/*",
        "http://localhost:1234/*",
        "http://localhost:11434/*",
        "https://translate.googleapis.com/*"
    ],
    "icons": {
        "16": "images/icon16.png",
        "48": "images/icon48.png",
        "128": "images/icon128.png"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "popup.html",
                "popup.js",
                "extension_api.js",
                "slang_dict.json"
            ],
            "matches": [
                "*://www.youtube.com/*",
                "*://m.youtube.com/*"
            ]
        }
    ]
}
